# Rende il profilo live quello di default
COMPOSE_PROFILES=live

# Per le porte pubblicate solo in locale
BIND_ADDRESS=127.0.0.1

# Sorgente dei post
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents?kinds=commit&collections=app.bsky.feed.post

ELASTIC_VERSION=9.4.4
KAFKA_VERSION=3.9.0
SPARK_VERSION=4.0.1
SCALA_VERSION=2.13

# Topic Kafka
TOPIC_RAW=posts.raw
TOPIC_DLQ=posts.dlq
TOPIC_ENRICHED=posts.enriched
TOPIC_ENRICHED_PARTITIONS=3
TOPIC_SENTIMENT=sentiment.1m
TOPIC_MONITOR=sentiment.monitor
TOPIC_ALERTS=alerts
TOPIC_ALERTS_EXPLAINED=alerts.explained

LOGSTASH_HEAP=640m
KAFKA_HEAP=256m
ES_HEAP=1g
KIBANA_HEAP_MB=768

#  Spark Q1, arricchimento sulla GPU integrata (i7-1165G7, WSL2)
#  Un solo task alla volta, con tutti e 4 i core
SPARK_Q1_CORES=4
SPARK_Q1_TASK_CPUS=4
SPARK_Q1_DRIVER_MEMORY=1g

SPARK_Q1_INFER_ENGINE=ov:fp32@GPU       # Motore scelto dalle varie prove
SPARK_Q1_INFER_BATCH_SIZE=32            # Post passati al modello ad ogni calcolo

# Post massimi per micro-batch
SPARK_Q1_MAX_OFFSETS_PER_TRIGGER=1500

#  Spark Q2 e Q3
SPARK_Q23_CORES=2
SPARK_Q23_DRIVER_MEMORY=1g

# Explainer (LLM). Chiave gratuita da https://aistudio.google.com/apikey
# Il .env non va messo su git: contiene la chiave
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # alternativa piu leggera: gemini-3.5-flash-lite